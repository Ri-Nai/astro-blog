{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@theme/*": [
        "./themes/astro-theme-kago/src/*"
      ],
      "@site.config": [
        "./src/site.config.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "themes/**/*"
  ]
}
