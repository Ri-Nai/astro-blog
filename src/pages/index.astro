---
import HomeLayout from "@theme/layouts/HomeLayout.astro";
import { homePageConfig, profileConfig } from "@site.config";
import { getSectionPosts } from "../utils/postStats";

// 首页的「最新文章」由 HomeLayout 直接读取整个 blog 集合，
// 因此两个分区（技术博客 / 个人随笔）都会出现在最新文章里。
// 这里额外补一个分区入口，让两个部分可以被直接进入。
const [techPosts, essayPosts] = await Promise.all([
  getSectionPosts("blog"),
  getSectionPosts("essay"),
]);

const sections = [
  {
    href: "/blog",
    icon: "📝",
    name: "技术博客",
    desc: "工程实践、踩坑记录与源码阅读",
    count: techPosts.length,
    latest: techPosts[0],
  },
  {
    href: "/essays",
    icon: "🍃",
    name: "个人随笔",
    desc: "生活碎片、课余沉思与年度记录",
    count: essayPosts.length,
    latest: essayPosts[0],
  },
];
---

<HomeLayout {...homePageConfig} profileConfig={profileConfig}>
  <section class="section-entry">
    <div class="section-header">
      <h2 class="section-title">
        <span class="title-icon">🗂️</span>
        文章分区
      </h2>
    </div>
    <div class="section-grid">
      {
        sections.map((section) => (
          <a class="section-card" href={section.href}>
            <div class="section-card-icon">{section.icon}</div>
            <h3 class="section-card-name">{section.name}</h3>
            <p class="section-card-desc">{section.desc}</p>
            <p class="section-card-count">共 {section.count} 篇</p>
            {section.latest && (
              <p class="section-card-latest">最近：{section.latest.data.title}</p>
            )}
          </a>
        ))
      }
    </div>
  </section>
</HomeLayout>

<style>
  .section-entry {
    margin-bottom: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .title-icon {
    font-size: 1.5rem;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .section-card {
    display: block;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .section-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--blog-shadow-3);
    border-color: var(--brand-primary);
  }

  .section-card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .section-card-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
  }

  .section-card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 0.75rem 0;
    line-height: 1.6;
  }

  .section-card-count {
    color: var(--brand-primary);
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
  }

  .section-card-latest {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin: 0.5rem 0 0 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .section-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .section-card {
      padding: 1.5rem 1rem;
    }
  }
</style>
