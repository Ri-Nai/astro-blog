---
import BlogLayout from "@theme/layouts/BlogLayout.astro";
import Navigation from "@theme/components/Navigation.astro";
import { getSectionPosts, getPostStats } from "../../utils/postStats";

// 只取 blog 分区（技术博客）的文章，随笔请见 /essays
const posts = await getSectionPosts("blog");
const { allTags, allCategories, tagCounts, categoryStats } = getPostStats(posts);
---

<BlogLayout
  title="技术博客 - Ri-Nai"
  description="技术分享与实践记录，按标签和分类筛选"
  posts={posts}
  allTags={allTags}
  allCategories={allCategories}
  tagCounts={tagCounts}
  categoryStats={categoryStats}
>
  <Navigation slot="navigation" />
</BlogLayout>
